# Copy this file to .env and replace the placeholders. Never commit .env.
# Format: KEY=value (no spaces around "=", no quotes needed).

# --- PostgreSQL (used by docker compose and by the backend) ---
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resume_reviewer
# Local (non-Docker) runs only; docker compose sets host=postgres, port=5432 itself.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- External APIs ---
GROQ_API_KEY=your-groq-api-key
YOUTUBE_API_KEY=your-youtube-data-api-key

# --- JWT authentication ---
# REQUIRED: a cryptographically random secret of at least 32 characters. The backend refuses to start with this
# placeholder, an empty value, a short one or a repetitive one. Generate a value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Optional ---
# Frontend -> backend URL for local (non-Docker) runs; Docker sets http://backend:8000.
# API_BASE_URL=http://localhost:8000
# Directory where the BACKEND stores uploaded PDFs (one sub-folder per user id).
# Default: ./src locally, /app/uploads in Docker (named volume).
# UPLOAD_DIR=
# Host ports published on 127.0.0.1 by docker compose.
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=8501
