# Environment variables and secrets
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
venv/
.venv/

# Logs
*.log
logs/

# Generated resume-analysis outputs
/src/ats_optimized_bullets.txt
