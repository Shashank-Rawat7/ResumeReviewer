  "meta": {
    "format_version": 1,
    "purpose": "Fixed technology vocabulary for the advisory check D4 (eval/ats/checks.py check_technologies). A bullet that names a term below which the source resume never mentions is flagged for review.",
    "status": "LIMITED SCREENING AID. It is not a complete technology ontology and is not proof that a claim is, or is not, supported by the resume.",
    "matching": "Case-insensitive; a term must be bounded by non-alphanumeric characters, so 'Java' does not match 'JavaScript', 'SQL' does not match 'NoSQL', 'Git' does not match 'GitHub' and 'Redis' does not match 'Redistribute'. Plural and spelling variants match only if listed as aliases.",
    "alias_policy": [
      "Aliases are exact alternative spellings of the SAME technology (Postgres, k8s, REST APIs, retrieval-augmented generation).",
      "No generic or ambiguous aliases: bare Go, R, C, Node, Spark, Ray, Express, Swift, React, Lambda, Chroma, transformers, agents, cloud or data are deliberately absent.",
      "Terms shorter than three characters are limited to S3 and C#.",
      "Every term and alias is unique across the whole vocabulary (case-insensitive)."
    ],
    "known_limitations": [
      "Technologies outside this list are invisible to the check (false negatives).",
      "A technology the resume names with a different word is flagged (false positive), e.g. 'message queue' for RabbitMQ.",
      "Related technologies are separate entries on purpose (Git and GitHub, Docker and Docker Compose, PostgreSQL and SQL).",
      "Common English words used as names (pandas, Streamlit, Locust, Sentry, Helm, Groq) can match ordinary prose in rare cases."
    ],
